ENVIRONMENT=development

# SQLite for local dev. For Supabase, run backend/supabase_schema.sql in the
# Supabase SQL editor first (see README), then use the "Session pooler" connection
# string from Settings -> Database, rewritten for SQLAlchemy:
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
DATABASE_URL=sqlite:///./lht_store.db

CORS_ORIGINS=["http://localhost:5173"]

SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720

ADMIN_EMAIL=hello@lhtstore.com

# Leave SMTP_HOST unset locally — emails are logged to the console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=hello@lhtstore.com
SMTP_USE_TLS=true

# Leave both unset locally — uploads save to ./uploads instead. Required on hosts
# with no persistent disk (e.g. Netlify Functions): create a public bucket in
# Supabase Storage, then set these to route uploads there instead.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=product-images
