ENVIRONMENT=production

# Plain postgres:// URI — NOT the SQLAlchemy-style postgresql+psycopg:// scheme
# used by backend/ (that +driver suffix is a Python/SQLAlchemy-only convention).
# The raw string Supabase's dashboard gives you (Settings -> Database ->
# Connection string -> Session pooler) works as-is.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres

CORS_ORIGINS=["http://localhost:5174"]

SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720

ADMIN_EMAIL=hello@lhtstore.com

# Leave SMTP_HOST unset locally — emails are logged to the console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=hello@lhtstore.com
SMTP_USE_TLS=true

# Required — Netlify Functions have no writable disk between invocations at
# all, so unlike backend/ there is no local-disk fallback for uploads here.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=product-images
